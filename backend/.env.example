OPENAI_API_KEY=your_openai_api_key_here

# Recommended for Unpaywall API etiquette.
UNPAYWALL_EMAIL=your_email@example.com

# OpenAlex paper search key: https://openalex.org/settings/api
OPENALEX_API_KEY=your_openalex_api_key_here

# Optional: add a contact email to OpenAlex requests.
OPENALEX_MAILTO=your_email@example.com

# Optional: use the Crossref polite pool and identify the requester.
CROSSREF_MAILTO=your_email@example.com

