# OpenAI Responses API (keep the real key only in .env or hosted secrets)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# OpenAlex paper search
# Create a free key at https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=researcher@example.com

# Optional: used for DOI-based open-access full-text resolution
UNPAYWALL_EMAIL=researcher@example.com

# Optional: improves Elsevier text-mining API access when publisher routes require a key
ELSEVIER_API_KEY=
